        <mxCell id="n54" value="conserva instantanea de&#10;N:1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#c9a227;strokeColor=#8a6d1a;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560.0" y="780.0" width="150" height="70" as="geometry"/></mxCell>
        <mxCell id="a55" style="endArrow=none;html=1;strokeColor=#5a6b7a;" edge="1" parent="1" source="n6" target="n54"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a56" style="endArrow=none;html=1;strokeColor=#5a6b7a;" edge="1" parent="1" source="n54" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n57" value="La ventana es UN atributo de tipo rango, no dos columnas.&#10;Eso hace declarativas dos reglas: que dos enlaces de la misma&#10;sesion no se solapen (RN-36) y que un instante este dentro (RN-15)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff8dc;strokeColor=#c9a227;fontSize=11;align=left;size=14;" vertex="1" parent="1"><mxGeometry x="620" y="20" width="400" height="100" as="geometry"/></mxCell>
        <mxCell id="n58" value="clave_hash: NUNCA la clave en claro.&#10;es_correo_institucional es DERIVADO del dominio de destino:&#10;vigila el asunto que quedo abierto en 55:32." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff8dc;strokeColor=#c9a227;fontSize=11;align=left;size=14;" vertex="1" parent="1"><mxGeometry x="1060" y="180" width="360" height="90" as="geometry"/></mxCell>
        <mxCell id="n59" value="LAS DOS INSTANTANEAS son la decision mas importante del modelo.&#10;No son referencias vivas: guardan el programa y la vinculacion que&#10;la persona tenia EL DIA de la catedra, y no se actualizan nunca.&#10;Sin ellas, el archivo enviado al ASIS deja de ser reproducible." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff8dc;strokeColor=#c9a227;fontSize=11;align=left;size=14;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="420" height="110" as="geometry"/></mxCell>
        <mxCell id="n60" value="CLAVE habilita REGISTRO es (1,1) por el lado del registro:&#10;NO HAY REGISTRO SIN CLAVE USADA. Es la antisuplantacion&#10;de 1:04:51 — &quot;si no, yo te registro a vos y vos me registras a mi&quot;." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff8dc;strokeColor=#c9a227;fontSize=11;align=left;size=14;" vertex="1" parent="1"><mxGeometry x="1040" y="880" width="420" height="100" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
