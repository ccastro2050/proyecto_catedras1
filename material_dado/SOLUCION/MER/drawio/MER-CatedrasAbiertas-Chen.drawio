        <mxCell id="n52" value="FACULTAD depende de FACULTAD es REFLEXIVA y produce un ARBOL:&#10;cada nodo tiene un solo padre. Por eso se resuelve con una columna&#10;en la misma tabla, y se consulta con WITH RECURSIVE." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff8dc;strokeColor=#c9a227;fontSize=11;align=left;size=14;" vertex="1" parent="1"><mxGeometry x="180" y="760" width="400" height="90" as="geometry"/></mxCell>
        <mxCell id="n53" value="fecha_ini ENTRA EN LA CLAVE PRIMARIA de rol_por_usuario.&#10;Sin ella, quien fue administrador, dejo de serlo y vuelve, quedaria&#10;bloqueado para siempre. Es el error que NO falla ruidosamente." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff8dc;strokeColor=#c9a227;fontSize=11;align=left;size=14;" vertex="1" parent="1"><mxGeometry x="1420" y="420" width="420" height="100" as="geometry"/></mxCell>
