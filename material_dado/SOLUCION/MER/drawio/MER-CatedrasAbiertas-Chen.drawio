        <mxCell id="n51" value="DETALLE_MIGRACION repite tres columnas a proposito: guarda LO QUE&#10;SE ENVIO, no lo que hoy dice la tabla. Si el programa de alguien&#10;cambia despues, los dos valores divergen legitimamente — y sin la&#10;copia, un rechazo del ASIS es indepurable seis meses despues." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff8dc;strokeColor=#c9a227;fontSize=11;align=left;size=14;" vertex="1" parent="1"><mxGeometry x="1400" y="720" width="420" height="110" as="geometry"/></mxCell>
        <mxCell id="n52" value="ESTADO_PROCESO son los CINCO estados literales del manual de&#10;migracion, pagina 6: En cola, En curso, Error, Correcto, Incorrecto." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff8dc;strokeColor=#c9a227;fontSize=11;align=left;size=14;" vertex="1" parent="1"><mxGeometry x="1400" y="60" width="400" height="70" as="geometry"/></mxCell>
