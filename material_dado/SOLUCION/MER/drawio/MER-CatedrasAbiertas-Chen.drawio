        <mxCell id="n53" value="numero es MULTIVALUADO -elipse doble-: 707 personas del maestro&#10;real tienen mas de un documento. Por eso es tabla propia." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff8dc;strokeColor=#c9a227;fontSize=11;align=left;size=14;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="340" height="80" as="geometry"/></mxCell>
