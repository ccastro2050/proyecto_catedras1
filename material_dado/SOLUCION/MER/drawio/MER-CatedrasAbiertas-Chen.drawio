        <mxCell id="a41" style="endArrow=none;html=1;strokeColor=#5a6b7a;" edge="1" parent="1" source="n39" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n42" value="RESPUESTA_ENCUESTA detalla RESPUESTA_ITEM es (1,N):&#10;toda encuesta respondida tiene AL MENOS UN item.&#10;&#10;NINGUNA CLAVE FORANEA PUEDE GARANTIZARLO. Una clave foranea&#10;garantiza que lo que se inserte EXISTA, no que se INSERTE algo.&#10;Se resuelve con procedimiento y se mide con una consulta de control." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff8dc;strokeColor=#c9a227;fontSize=11;align=left;size=14;" vertex="1" parent="1"><mxGeometry x="1040" y="700" width="440" height="130" as="geometry"/></mxCell>
        <mxCell id="n43" value="Los tres valores de RESPUESTA_ITEM no son opcionalidad:&#10;son una REGLA CONDICIONAL. El tipo de la pregunta decide cual&#10;de los tres se usa. Los tres vacios, o dos llenos, es dato corrupto." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff8dc;strokeColor=#c9a227;fontSize=11;align=left;size=14;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="420" height="100" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
