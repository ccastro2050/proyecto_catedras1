        <mxCell id="n49" value="nombre_asis es DERIVADO -elipse punteada-: los 30 primeros&#10;caracteres. El ASIS trunca ahi. Se guarda el largo y se deriva&#10;el corto; al reves se perderia informacion." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff8dc;strokeColor=#c9a227;fontSize=11;align=left;size=14;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="360" height="90" as="geometry"/></mxCell>
        <mxCell id="n50" value="SESION es entidad DEBIL: la &quot;reunion 3&quot; no significa nada suelta,&#10;es la reunion 3 DE UN EVENTO. Su identificador incluye la catedra.&#10;El par (catedra, reunion) es unico en las 5.711 filas reales." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff8dc;strokeColor=#c9a227;fontSize=11;align=left;size=14;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="380" height="100" as="geometry"/></mxCell>
        <mxCell id="n51" value="canal_difusion gobierna comportamiento, no es una etiqueta:&#10;presencial se difunde por QR, virtual por enlace (1:06:53)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff8dc;strokeColor=#c9a227;fontSize=11;align=left;size=14;" vertex="1" parent="1"><mxGeometry x="1080" y="460" width="360" height="70" as="geometry"/></mxCell>
