flowchart LR
    ASI["ASISTENTE"]
    DOC["DOCUMENTO_ASISTENTE"]
    TDO["TIPO_DOCUMENTO"]
    TVI["TIPO_VINCULACION"]
    CON["CONSENTIMIENTO_DATOS"]

    a1(["<u>id_asistente</u>"]) --- ASI
    a2(["id_asis (único)"]) --- ASI
    a3(["nombres"]) --- ASI
    a4(["apellidos"]) --- ASI
    a5(["correo_institucional"]) --- ASI
    a6(["correo_personal"]) --- ASI
