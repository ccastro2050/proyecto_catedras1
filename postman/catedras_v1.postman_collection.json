          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "sede"
          ]
        },
        "description": "La llave primaria la defiende la base (pk_sede), no la API.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"idSede\": \"ITAGUI\",\n  \"nombre\": \"Otro nombre\",\n  \"direccion\": \"Calle 50 51-20\",\n  \"esVirtual\": false\n}",
