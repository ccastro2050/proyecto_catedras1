        "description": "Solo se escribe lo que llegó.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Campus Itagui\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "10. PATCH vacío → 400",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/sede/ITAGUI",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "sede",
            "ITAGUI"
          ]
