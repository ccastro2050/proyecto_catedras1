<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PruebaCapas</AssemblyName>
    <RootNamespace>PruebaCapas</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Se compilan SOLO las capas que la prueba necesita: el servicio, la
         entidad, las interfaces y la excepción. NO se referencia el proyecto
         de la API, ni Npgsql, ni Dapper — y eso es justamente la prueba: si
         hiciera falta el paquete del motor para probar el negocio, la
         separación de capas no sería real. -->
    <Compile Include="../Modelos/Sede.cs" />
    <Compile Include="../Excepciones/NoEncontradoExcepcion.cs" />
    <Compile Include="../Repositorios/IRepositorioSede.cs" />
    <Compile Include="../Servicios/IServicioSede.cs" />
    <Compile Include="../Servicios/ServicioSede.cs" />
  </ItemGroup>

</Project>
